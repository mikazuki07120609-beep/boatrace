<script language="javascript" type="text/javascript">
function CheckStn() {
	var sn = document.fc.stn.selectedIndex;
	var strs = document.fc.stn.options[sn].value;
	if ( strs == "top" ) {
		document.fc.alert.value="表示地点を選択してください。"
		return false;
	}
	return true;
}
</script>
<form name="fc" id="fc" method="post" action="suisan.php" onsubmit='return CheckStn()'>
